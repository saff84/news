APP_ENV=dev
DATABASE_URL=postgresql+psycopg://newsint:newsint@db:5432/newsint
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5173
STORAGE_DIR=/data/storage
TELEGRAM_SESSION_DIR=/data/tg

# Docker Compose convenience (used by docker-compose.yml substitutions)
# Set PUBLIC_HOST to your VPS public DNS name or public IP (no scheme, no port).
PUBLIC_HOST=localhost
#
# Optional overrides (if you don't want the default :5173 / :8000 mapping):
# UI_ORIGIN=http://example.com:5173
# API_PUBLIC_URL=   # пусто (по умолчанию): фронт ходит на /api через nginx
# API_PUBLIC_URL=http://localhost:8000   # только для отдельного dev-сборки фронта

# Telegram MTProto (Telethon)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Альтернатива tg-auth: session string (сгенерировать: python backend/scripts/generate_telegram_session_string.py)
TELEGRAM_SESSION_STRING=

# MAX Bot API
MAX_API_BASE=https://platform-api.max.ru
MAX_BOT_TOKEN=

# VK API
VK_API_BASE=https://api.vk.com/method
VK_API_VERSION=5.199
VK_ACCESS_TOKEN=

# Feature flags
ENABLE_LLM=false

# Scheduler worker: пересборка кластеров новостей (секунды между enqueue; 0 = выкл)
NEWS_CLUSTER_REBUILD_INTERVAL_S=21600

# Ротация логов Docker (json-file на диске хоста)
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5

# Очистка опубликованных HTML в storage/reports (не логи, но тоже диск)
REPORTS_KEEP_DAYS=90
REPORTS_KEEP_COUNT=50
REPORTS_PRUNE_INTERVAL_S=86400
